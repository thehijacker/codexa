# Generate a secure secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

PORT=3000

# Network address to listen on. Keep the Docker default (0.0.0.0), or use
# 127.0.0.1 when a local reverse proxy provides public HTTPS.
HOST=0.0.0.0

# REQUIRED: Replace with a long random string before first run
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# Directory to store books, covers, fonts, and the SQLite database
DATA_DIR=./data

# Optional: restrict CORS to your domain (leave blank to allow same-origin only)
CORS_ORIGIN=

# Set to true to enable verbose console logging in the browser (default: false)
DEBUG=false

# Optional: OIDC login (Google, Apple, or a self-hosted provider like Dex/Authelia/Keycloak).
# Leave OIDC_PROVIDERS blank/unset to disable — no "Sign in with..." buttons will appear.
# See README for the full setup guide, including a self-hosted Dex example with predefined users.
#
# OIDC_PROVIDERS=google,dex
# OIDC_BASE_URL=https://books.example.com
#
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_NAME=Google
#
# OIDC_DEX_ISSUER=https://auth.example.com/dex
# OIDC_DEX_CLIENT_ID=
# OIDC_DEX_CLIENT_SECRET=
# OIDC_DEX_NAME=Home SSO
